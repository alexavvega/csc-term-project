<!DOCTYPE html>
<html>
<head>
  <title>Search Results for "<%= query %>"</title>
</head>
<body>
  <h1>Results for "<%= query %>"</h1>
  <% if (results.length === 0) { %>
    <p>No matching games found.</p>
  <% } else { %>
    <ul>
      <% results.forEach(game => { %>
        <li><strong><%= game.name %></strong>: $<%= game.price %></li>
      <% }) %>
    </ul>
  <% } %>
  <a href="/">Back to Home</a>
</body>
</html>
